# PGAI Voice Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file

# Vapi.ai credentials (https://vapi.ai → Dashboard → API Keys)
VAPI_API_KEY=

# UUID of your Vapi phone number (Dashboard → Phone Numbers → your number → copy ID)
VAPI_PHONE_NUMBER_ID=

# OpenAI API key (https://platform.openai.com → API → Keys)
# Used by Vapi as the LLM provider for patient conversation logic
OPENAI_API_KEY=

# Target phone number — DO NOT change this unless instructed
TARGET_PHONE=+18054398008
